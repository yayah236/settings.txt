--------------------------------------------------

local ambientIntensity =
	get("VisualSettings", "AmbientIntensity", 3.35)

-- Approximate the ReShade ambient-light effect.
local ambient = math.clamp(ambientIntensity / 10, 0, 1)

Lighting.EnvironmentDiffuseScale = ambient
Lighting.EnvironmentSpecularScale = math.clamp(ambient + 0.15, 0, 1)

--------------------------------------------------
-- LOAD GITHUB FILE
--------------------------------------------------

local function loadSettings()

	local success, result = pcall(function()
		return HttpService:GetAsync(SETTINGS_URL)
	end)

	if not success then
		warn("[Visual Loader] Failed to download settings:")
		warn(result)
		return false
	end

	if not result or result == "" then
		warn("[Visual Loader] GitHub returned an empty file.")
		return false
	end

	parseSettings(result)

	print("[Visual Loader] Settings downloaded successfully.")

	return true
end

