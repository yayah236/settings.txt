2. Complete Roblox script
Create a normal Script in ServerScriptService and paste this in:

--[[
	Roblox Visual Preset Loader
	Loads visual settings from GitHub and applies
	Roblox-compatible post-processing effects.

	Place this Script inside:
	ServerScriptService

	IMPORTANT:
	Enable:
	Game Settings -> Security -> Allow HTTP Requests
]]

local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")

--------------------------------------------------
-- CONFIGURATION
--------------------------------------------------

local SETTINGS_URL = "https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPOSITORY/main/settings.txt"

--------------------------------------------------
-- PARSER
--------------------------------------------------

local settings = {}
local currentSection = ""

local function parseValue(value)
	value = value:match("^%s*(.-)%s*$")

	if value == "true" then
		return true
	elseif value == "false" then
		return false
	end

	local number = tonumber(value)

	if number ~= nil then
		return number
	end

	return value
end

local function parseSettings(data)
	settings = {}
	currentSection = ""

	for line in data:gmatch("[^\r\n]+") do

		-- Remove comments
		line = line:gsub("#.*$", "")
		line = line:gsub("^%s+", "")
		line = line:gsub("%s+$", "")

		if line ~= "" then

			-- Section
			local section = line:match("^%[(.-)%]$")

			if section then
				currentSection = section

				if not settings[currentSection] then
					settings[currentSection] = {}
				end

			else

				-- Key=value
				local key, value = line:match("^([^=]+)=(.*)$")

				if key and value then
					key = key:gsub("^%s+", ""):gsub("%s+$", "")
					settings[currentSection][key] = parseValue(value)
				end
			end
		end
	end

	return settings
end

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function get(section, key, default)
	if settings[section] and settings[section][key] ~= nil then
		return settings[section][key]
	end

	return default
end

local function getEffect(className, name)
	local existing = Lighting:FindFirstChild(name)

	if existing and existing:IsA(className) then
		return existing
	end

	if existing then
		existing:Destroy()
	end

	local effect = Instance.new(className)
	effect.Name = name
	effect.Parent = Lighting

	return effect
end

